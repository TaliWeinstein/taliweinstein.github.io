author = {José M. R. Flauzino  and Abdulkadir Sanli  and Rudolph R. Shirima  and Yuanjun Cai  and Tinghao Hu  and Leyang Li  and Taliya Weinstein  and Hong Seok Lee  and Tayeb Tadlaoui  and Selin Olenik  and Abdülkadir Gümüşçü  and Laura Gonzalez-Macia  and George Mahuku  and James Legg  and Anthony E. G. Cass  and Firat Güder },
title = {Electrochemical lateral flow assay with ELISA-level performance for detecting plant diseases in East Africa},
journal = {Proceedings of the National Academy of Sciences},
